---
import "../styles/global.css";
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    
    <!-- Devicon CSS -->
    <link rel="stylesheet" type='text/css' href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css" />

    <!-- Favicons -->
    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Meta tags -->
    <meta name="description" content="Portfolio de desarrollador web Full Stack. Proyectos con React, Astro y Spring Boot. Especializado en interfaces modernas y aplicaciones web reales.">
    <meta name="keywords" content="desarrollador web, full stack developer, portfolio programador, React, Astro, Spring Boot, Java, JavaScript, frontend, backend, proyectos web, Mysql, frontend moderno, aplicaciones web, interfaces de usuario, desarrollo de software.">
    <meta name="author" content="Eliaser Pérez Yaque">
    <meta name="robots" content="index, follow">
    
    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content="EliaserDev | Full Stack Developer">
    <meta property="og:description" content="Portfolio de desarrollador web con proyectos reales como un estudio de tatuajes con sistema de reservas.">
    <meta property="og:image" content="/desarrolladorFullstack.png">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Portfolio Desarrollador y Programador de Aplicaciones Web Fullstack </title>
  </head>
  <body class="bg-zinc-950 text-white font-sans selection:bg-white selection:text-black">
    <slot />
  </body>
</html>

<script type="module" src="/scrollReveal.js"></script>
